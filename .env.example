# Template only: commit names, never values.
# Real values go in ~/.kama/.env (all workspaces) or ./.env (this directory; git-ignored).
# Priority: ~/.kama/.env < ./.env < environment variables. Save as UTF-8.
KAMA_HOST=127.0.0.1
KAMA_PORT=7437
KAMA_LOG_LEVEL=INFO

ANTHROPIC_API_KEY=
KAMA_MODEL=claude-opus-5
KAMA_MAX_STEPS=30
# KAMA_EFFORT=high          # low | medium | high | xhigh | max; unset = API default
# KAMA_REFUSAL_FALLBACK=true
# KAMA_PLANNING=true       # false = no task_* tools (the S2 agent; for eval A/B runs)
# KAMA_MEMORY=true         # false = no session history, no notes (the S3 agent; A/B)
# KAMA_SESSIONS_DIR=~/.kama/sessions
# KAMA_MEMORY_DIR=~/.kama/memory
# KAMA_RUNS_DIR=~/.kama/runs
# KAMA_TOKEN_FILE=~/.kama/core.token
# KAMA_APPROVAL_TIMEOUT_S=600
# KAMA_POLICY=true         # false = the S4 approvals (for eval A/B runs)
# KAMA_POLICY_FILE=~/.kama/policy.toml
# KAMA_SANDBOX=auto        # auto | bwrap | unshare | off (Ubuntu: apt install bubblewrap)
# KAMA_BASH_ENV_KEEP=      # e.g. GITHUB_TOKEN: credential-looking vars bash may see
# KAMA_PRIVATE_PATHS=      # more paths no tool call may read or change
# KAMA_LLM_MAX_RETRIES=4
# KAMA_LLM_RETRY_BUDGET_S=120
